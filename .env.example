# Spotify Developer App Credentials
# https://developer.spotify.com/dashboard adresinden oluşturduğunuz uygulamanın bilgileri:

SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Note: In Spotify Developer Dashboard -> App Settings -> Redirect URIs,
# add BOTH:
# 1) http://127.0.0.1:8888/callback
# 2) http://localhost:8888/callback
